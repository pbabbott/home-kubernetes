{
  "mcpServers": {
    "grafana-prod": {
      "command": "uvx",
      "args": [
        "mcp-grafana"
      ],
      "env": {
        "GRAFANA_URL": "https://grafana.local.abbottland.io",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_TOKEN_PROD}"
      }
    },
    "arr": {
      "type": "http",
      "url": "https://mcp-arr.local.abbottland.io/mcp"
    },
    "qbittorrent": {
      "type": "sse",
      "url": "https://mcp-qbittorrent.local.abbottland.io/sse"
    }
  }
}
